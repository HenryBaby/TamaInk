+void tamalib_export_extended_state(tamalib_extended_state_t *out)
+{
+	if (!out) return;
+	cpu_export_extended_state(&out->cpu);
+	out->exec_mode = exec_mode; out->step_depth = step_depth;
+	out->screen_ts = screen_ts; out->ts_freq = ts_freq; out->framerate = g_framerate;
+}
+
+bool_t tamalib_import_extended_state(const tamalib_extended_state_t *in)
+{
+	if (!in || !cpu_import_extended_state(&in->cpu)) return 0;
+	exec_mode = in->exec_mode; step_depth = in->step_depth;
+	screen_ts = in->screen_ts; ts_freq = in->ts_freq; g_framerate = in->framerate;
+	return 1;
+}
