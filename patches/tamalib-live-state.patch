+/* TamaInk checkpoint bridge: complete CPU continuation state. */
+typedef struct {
+	u13_t pc, next_pc;
+	u12_t x, y;
+	u4_t a, b, flags;
+	u5_t np;
+	u8_t sp, previous_cycles, speed_ratio;
+	u32_t tick_counter, clk_timer_timestamps[8], prog_timer_timestamp;
+	bool_t prog_timer_enabled, cpu_halted;
+	u8_t prog_timer_data, prog_timer_rld;
+	u32_t call_depth, ts_freq, ref_ts, cpu_frequency, scaled_cycle_accumulator;
+	interrupt_t interrupts[INT_SLOT_NUM];
+	MEM_BUFFER_TYPE memory[MEM_BUFFER_SIZE];
+	u8_t input_states[2];
+} cpu_extended_state_t;
+
+void cpu_export_extended_state(cpu_extended_state_t *out);
+bool_t cpu_import_extended_state(const cpu_extended_state_t *in);
+
 
 void cpu_add_bp(breakpoint_t **list, u13_t addr);
 void cpu_free_bp(breakpoint_t **list);
